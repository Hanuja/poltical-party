# Database
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=political_party_db
DB_USER=root
DB_PASS=

# JWT (generate a long random string)
JWT_SECRET=change-this-to-a-long-random-secret
JWT_TTL=86400

# CORS - comma separated allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Upload limits (bytes)
UPLOAD_MAX_IMAGE=5242880
UPLOAD_MAX_DOC=10485760

# Site URL (used in emails / password reset links)
SITE_URL=http://localhost/poltical%20party
